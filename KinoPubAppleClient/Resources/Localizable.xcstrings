    "Settings_Tip_Diagnostics": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspect what streams kino.pub actually delivers."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверить, какие потоки kino.pub реально отдаёт."
          }
        }
      }
    },
    "Settings_Tip_DualSubtitles": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show a second subtitle track under the first. A track picked in the player wins over these defaults and is remembered for the next episode."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать вторую дорожку субтитров под первой. Выбор в плеере важнее этих настроек и запоминается для следующей серии."
          }
        }
      }
    },
    "Settings_Tip_EnglishSubtitles": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on English subtitles automatically when you start watching. A track picked in the player wins over this default."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включать английские субтитры автоматически при старте. Выбор в плеере важнее этой настройки."
          }
        }
      }
    },
    "Settings_Tip_HomeBanner": {
      "comment": "tvOS Settings tip for the Home banner feature toggle.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the contained banner shelf on Home. When off, the shelf is gone and no banner artwork is loaded."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать баннерную полку на главной. Если выключено — полки нет и арт для неё не грузится."
          }
        }
      }
    },
    "Settings_Tip_Kinopoisk": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your own Kinopoisk Unofficial API key for photos, facts and awards on detail pages."
