        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чип длительности слева снизу. Счётчик новых серий (+N) — подпись под названием, не чип в заголовке. Затемнение/галочка — только для вертикальных постеров."
          }
        }
      }
    },
