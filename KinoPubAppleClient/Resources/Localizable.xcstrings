    "Auth_Activate" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activate"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktyvuoti"
          }
        },
        "ru" : {
          "stringUnit" : {
